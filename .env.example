# Copie para .env.local e preencha. Nunca envie o .env.local ao GitHub.

# --- Supabase (projeto novo, em uma organização nova) ---
# Project Settings > Data API (URL) e API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco).
# Usada só pelos scripts npm run db:migrate e db:seed; não vai para a Vercel.
DATABASE_URL=

# --- E-mail (Brevo, mesmo remetente verificado dos outros projetos) ---
# Brevo > SMTP & API > API keys. Crie uma chave própria para este projeto.
BREVO_API_KEY=
EMAIL_FROM=Traço Studio <seu-email@gmail.com>
# Para onde vão as mensagens do formulário de contato.
CONTACT_INBOX=seu-email@gmail.com
